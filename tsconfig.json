{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "./src",
    "outDir": "./dist",

    "types": ["node"],

    "strict": true,

    "sourceMap": true,

    "esModuleInterop": true,

    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules","dist"]
}
