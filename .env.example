# ==================================================
# Server
# ==================================================
PORT=8000
NODE_ENV=development

# ==================================================
# Database
# ==================================================
MONGO_URI=mongodb://localhost:27017/klyro

# ==================================================
# JWT
# ==================================================
ACCESS_TOKEN_SECRET=your_access_token_secret
ACCESS_TOKEN_EXPIRY=15m

REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRY=7d

# ==================================================
# Google OAuth
# ==================================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ==================================================
# SMTP (Google OAuth2)
# ==================================================
SMTP_USER=your_email@gmail.com
SMTP_CLIENT_ID=your_google_oauth_client_id
SMTP_CLIENT_SECRET=your_google_oauth_client_secret
SMTP_REFRESH_TOKEN=your_google_oauth_refresh_token

# ==================================================
# Frontend
# ==================================================
FRONTEND_URL=http://localhost:5173

# ==================================================
# Admin
# ==================================================
ADMIN_NAME=KLYRO Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me